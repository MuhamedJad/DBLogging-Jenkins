                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+33762ff4-13b0-4f1e-b054-df2285fd7d43+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns4=&quot;http://tns.tibco.com/bw/json/1720554589625&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;TimeZoneHour&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcUpdateActivityInput>&lt;System_Name>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns4:System)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/tns4:System&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/System_Name>&lt;Host_Name>&lt;xsl:value-of select=&quot;$ParseXml/tns4:HostName&quot;/>&lt;/Host_Name>&lt;Node_Name>&lt;xsl:value-of select=&quot;$ParseXml/tns4:NodeName&quot;/>&lt;/Node_Name>&lt;Application_Name>&lt;xsl:value-of select=&quot;$ParseXml/tns4:AppName&quot;/>&lt;/Application_Name>&lt;Application_Version>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns4:AppVersion)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/tns4:AppVersion&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Application_Version>&lt;Process_Name>&lt;xsl:value-of select=&quot;$ParseXml/tns4:ProcessName&quot;/>&lt;/Process_Name>&lt;Business_ID_Name>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns4:BusinessIDName)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/tns4:BusinessIDName&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Business_ID_Name>&lt;Business_ID_Value>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns4:BusinessIDValue)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/tns4:BusinessIDValue&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Business_ID_Value>&lt;Caller_System>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns4:CallerSystem)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/tns4:CallerSystem&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Caller_System>&lt;Transaction_ID>&lt;xsl:value-of select=&quot;$ParseXml/tns4:TransactionID&quot;/>&lt;/Transaction_ID>&lt;Service_Name>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns4:ServiceName)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/tns4:ServiceName&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Service_Name>&lt;Service_URI>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns4:ServiceURI)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/tns4:ServiceURI&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Service_URI>&lt;Message>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns4:Message)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/tns4:Message&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Message>&lt;Request_Payload>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns4:RequestPayload)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/tns4:RequestPayload&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Request_Payload>&lt;Response_Payload>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns4:ResponsePayload)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/tns4:ResponsePayload&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Response_Payload>&lt;Request_Ref_Number>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns4:ReqRefNumber)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/tns4:ReqRefNumber&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Request_Ref_Number>&lt;Log_Level>&lt;xsl:value-of select=&quot;$ParseXml/tns4:LogLevel&quot;/>&lt;/Log_Level>&lt;Correlation_ID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns4:CorrelationID)&quot;>&lt;xsl:value-of select=&quot;$ParseXml/tns4:CorrelationID&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Correlation_ID>&lt;Timestamp>&lt;xsl:value-of select=&quot;$ParseXml/tns4:Timestamp&quot;/>&lt;/Timestamp>&lt;InsertionTimestamp>&lt;xsl:value-of select=&quot;tib:current-dateTime-timezone($TimeZoneHour, 0)&quot;/>&lt;/InsertionTimestamp>&lt;/tns1:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO [dbo].[logs]&#xa;           ([System_Name]&#xa;           ,[Host_Name]&#xa;           ,[Node_Name]&#xa;           ,[Application_Name]&#xa;           ,[Application_Version]&#xa;           ,[Process_Name]&#xa;           ,[Business_ID_Name]&#xa;           ,[Business_ID_Value]&#xa;           ,[Caller_System]&#xa;           ,[Transaction_ID]&#xa;           ,[Service_Name]&#xa;           ,[Service_URI]&#xa;           ,[Message]&#xa;           ,[Request_Payload]&#xa;           ,[Response_Payload]&#xa;           ,[Request_Ref_Number]&#xa;           ,[Log_Level]&#xa;           ,[Correlation_ID]&#xa;           ,[Timestamp],&#xa;           [InsertionTimestamp])&#xa;           &#xa;     VALUES&#xa;           (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)"
                                    timeout="1000" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="System_Name"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Host_Name"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Node_Name"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Application_Name"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Application_Version"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Process_Name"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Business_ID_Name"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Business_ID_Value"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Caller_System"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Transaction_ID"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Service_Name"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Service_URI"/>
                                    <PreparedParameters
                                    DataType="-9"
                                    DataTypeDisplayValue="NVARCHAR" ParameterName="Message"/>
                                    <PreparedParameters
                                    DataType="-9"
                                    DataTypeDisplayValue="NVARCHAR" ParameterName="Request_Payload"/>
                                    <PreparedParameters
                                    DataType="-9"
                                    DataTypeDisplayValue="NVARCHAR" ParameterName="Response_Payload"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Request_Ref_Number"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Log_Level"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Correlation_ID"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="Timestamp"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="InsertionTimestamp"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
