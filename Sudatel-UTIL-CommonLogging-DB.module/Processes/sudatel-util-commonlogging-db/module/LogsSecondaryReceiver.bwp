                    name="WriteCorruptedMsgFailure"
                    outputVariable="WriteCorruptedMsgFailure"
                    tibex:xpdlId="8afc6741-9365-48c3-ac76-df80de816664" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ParseXmlToWriteCorruptedMsgFailure"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="WriteCorruptedMsgFailureToConfirm1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+8afc6741-9365-48c3-ac76-df80de816664+JavaInvokeActivityInput&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;TimeZoneHour&quot;/>&lt;xsl:param name=&quot;CorruptedMsgFailureFailureFilePath&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:param name=&quot;FileSizeLimitBytes&quot;/>&lt;xsl:param name=&quot;CorruptedMsgFailureFailureFileName&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;WriteCorruptedMsgFailure-input&quot; match=&quot;/&quot;>&lt;tns8:JavaInvokeActivityInput>&lt;MethodParameters>&lt;logType>&lt;xsl:value-of select=&quot;$CorruptedMsgFailureFailureFileName&quot;/>&lt;/logType>&lt;log>&lt;xsl:value-of select=&quot;concat( &amp;quot;error corrupted message &amp;quot;,$JMSReceiveMessage/Body , &amp;quot;&amp;#xA;&amp;quot; , $_error/Msg)&quot;/>&lt;/log>&lt;directoryPath>&lt;xsl:value-of select=&quot;$CorruptedMsgFailureFailureFilePath&quot;/>&lt;/directoryPath>&lt;maxSizeBytes>&lt;xsl:value-of select=&quot;$FileSizeLimitBytes&quot;/>&lt;/maxSizeBytes>&lt;timezoneOffsetHours>&lt;xsl:value-of select=&quot;$TimeZoneHour&quot;/>&lt;/timezoneOffsetHours>&lt;/MethodParameters>&lt;/tns8:JavaInvokeActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.java.javamethod"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:java="http://ns.tibco.com/bw/palette/java" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/java#//JavaMethod"/>
                                    <value
                                    className="FileWrite.FileSystemWriter"
                                    isNew="true"
                                    isNewActivity="true"
                                    isStaticMethod="true"
                                    methodName="writeLog"
                                    methodReturn="void" xsi:type="java:JavaMethod">
                                    <methodParameter
                                    paramName="logType" paramType="string"/>
                                    <methodParameter paramName="log" paramType="string"/>
                                    <methodParameter
                                    paramName="directoryPath" paramType="string"/>
                                    <methodParameter
                                    paramName="maxSizeBytes" paramType="long"/>
                                    <methodParameter
                                    paramName="timezoneOffsetHours" paramType="int"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
